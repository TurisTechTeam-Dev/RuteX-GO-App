rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    function hasValidNewUserData(userId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'nombre',
          'usuario',
          'email',
          'avatar',
          'fecha_creacion',
          'ultimo_acceso',
          'puntos',
          'rutas_completadas',
          'isAdmin'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.puntos == 0
        && request.resource.data.rutas_completadas is list;
    }

    function keepsProtectedUserData() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.fecha_creacion == resource.data.fecha_creacion;
    }

    function updatesOnlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'usuario',
        'avatar',
        'email',
        'ultimo_acceso',
        'puntos',
        'rutas_completadas'
      ]);
    }

    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) && hasValidNewUserData(userId);

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && keepsProtectedUserData()
          && updatesOnlyProfileFields()
        );
    }

    match /{coleccion}/{document=**} {
      allow read: if coleccion in [
        'ciudades',
        'rutas',
        'misiones',
        'puntos_interes',
        'config_rangos',
        'resultado'
      ];

      allow write: if isAdmin();
    }
  }
}
